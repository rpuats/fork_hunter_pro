import { useState } from 'react'
import { motion, AnimatePresence } from 'framer-motion'
import { 
  Plus, RefreshCw, ShieldCheck, Wallet, TrendingUp, AlertTriangle,
  CheckCircle2, XCircle, Clock, ChevronRight, Settings, History,
  PiggyBank, ArrowUpDown, Bot, X, CreditCard, Percent, Timer,
  Flame, Gem
} from 'lucide-react'
import { demoAccounts } from '../lib/demoData'

const container = { hidden: { opacity: 0 }, show: { opacity: 1, transition: { staggerChildren: 0.05 } } }
const item = { hidden: { opacity: 0, y: 20 }, show: { opacity: 1, y: 0, transition: { duration: 0.3 } } }

const formatMoney = (amount: number) => new Intl.NumberFormat('ru-RU').format(amount) + ' ₽'

const formatRelativeTime = (dateStr: string | null) => {
  if (!dateStr) return '—'
  const diff = Math.floor((Date.now() - new Date(dateStr).getTime()) / 60000)
  if (diff < 1) return 'только что'
  if (diff < 60) return `${diff} мин назад`
  const hours = Math.floor(diff / 60)
  if (hours < 24) return `${hours} ч назад`
  return `${Math.floor(hours / 24)} дн назад`
}

const statusConfig = {
  connected: { label: 'Подключен', color: 'bg-emerald-500', text: 'text-emerald-400' },
  disconnected: { label: 'Отключен', color: 'bg-gray-500', text: 'text-gray-400' },
  error: { label: 'Ошибка', color: 'bg-red-500', text: 'text-red-400' },
  expired: { label: 'Сессия истекла', color: 'bg-amber-500', text: 'text-amber-400' }
}

const riskConfig = {
  low: { color: 'bg-emerald-500/20 text-emerald-400 border-emerald-500/30', label: 'Низкий риск' },
  medium: { color: 'bg-amber-500/20 text-amber-400 border-amber-500/30', label: 'Средний риск' },
  high: { color: 'bg-red-500/20 text-red-400 border-red-500/30', label: 'Высокий риск' },
  blocked: { color: 'bg-red-500/30 text-red-300 border-red-500/50', label: 'Заблокирован' }
}

export function AccountsPage() {
  const [accounts] = useState(demoAccounts)
  const [selectedAccount, setSelectedAccount] = useState<any>(null)

  const totalBankroll = accounts.reduce((sum, a) => sum + a.balance, 0)
  const totalAvailable = accounts.reduce((sum, a) => sum + a.available, 0)
  const totalLocked = accounts.reduce((sum, a) => sum + a.locked, 0)
  const totalProfit = accounts.reduce((sum, a) => sum + a.totalProfit, 0)
  const connectedCount = accounts.filter(a => a.connectionStatus === 'connected').length

  return (
    <motion.div variants={container} initial="hidden" animate="show" className="p-6 space-y-6">
      {/* Header */}
      <motion.div variants={item} className="flex items-center justify-between">
        <div>
          <h1 className="text-2xl font-bold text-text-primary">Аккаунты и Банкролл</h1>
          <p className="text-sm text-text-secondary mt-1">Управление счетами в букмекерских конторах</p>
        </div>
        <div className="flex gap-3">
          <button className="btn btn-secondary text-sm flex items-center gap-2">
            <RefreshCw size={16} /> Обновить все
          </button>
          <button className="btn btn-primary text-sm flex items-center gap-2">
            <Plus size={16} /> Добавить аккаунт
          </button>
        </div>
      </motion.div>

      {/* Bankroll Overview - 4 cards */}
      <div className="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        <motion.div variants={item} className="rounded-card border border-border bg-surface p-5">
          <div className="text-sm text-text-secondary mb-1">Общий банкролл</div>
          <div className="text-3xl font-bold text-text-primary">{formatMoney(totalBankroll)}</div>
          <div className="text-sm text-emerald-400 mt-1">+{formatMoney(totalProfit)} за всё время</div>
        </motion.div>
        <motion.div variants={item} className="rounded-card border border-border bg-surface p-5">
          <div className="text-sm text-text-secondary mb-1">Доступно</div>
          <div className="text-3xl font-bold text-emerald-400">{formatMoney(totalAvailable)}</div>
          <div className="text-sm text-text-secondary mt-1">{Math.round((totalAvailable/totalBankroll)*100)}% от общего</div>
        </motion.div>
        <motion.div variants={item} className="rounded-card border border-border bg-surface p-5">
          <div className="text-sm text-text-secondary mb-1">В ставках</div>
          <div className="text-3xl font-bold text-blue-400">{formatMoney(totalLocked)}</div>
          <div className="text-sm text-text-secondary mt-1">{accounts.filter(a => a.locked > 0).length} активных</div>
        </motion.div>
        <motion.div variants={item} className="rounded-card border border-border bg-surface p-5">
          <div className="text-sm text-text-secondary mb-1">Подключено</div>
          <div className="text-3xl font-bold text-text-primary">{connectedCount}/{accounts.length}</div>
          <div className="text-sm text-text-secondary mt-1">{accounts.filter(a => a.connectionStatus === 'error').length} с ошибкой</div>
        </motion.div>
      </div>

      {/* Distribution */}
      <motion.div variants={item} className="rounded-card border border-border bg-surface p-5">
        <h3 className="text-base font-semibold text-text-primary mb-4">Распределение по БК</h3>
        <div className="space-y-3">
          {accounts.map(acc => {
            const pct = Math.round((acc.balance / totalBankroll) * 100)
            return (
              <div key={acc.id} className="flex items-center gap-4">
                <div className="w-16 text-sm font-medium text-text-primary">{acc.name}</div>
                <div className="flex-1 h-2 bg-background rounded-full overflow-hidden">
                  <div 
                    className={`h-full rounded-full ${acc.connectionStatus === 'connected' ? 'bg-emerald-500' : 'bg-red-500'}`}
                    style={{ width: `${pct}%` }}
                  />
                </div>
                <div className="w-20 text-right text-sm text-text-secondary">{pct}%</div>
                <div className="w-24 text-right text-sm font-medium text-text-primary">{formatMoney(acc.balance)}</div>
              </div>
            )
          })}
        </div>
      </motion.div>

      {/* Account Cards Grid */}
      <motion.div variants={item}>
        <h3 className="text-base font-semibold text-text-primary mb-4">Аккаунты</h3>
        <div className="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-4">
          {accounts.map(account => (
            <motion.div 
              key={account.id}
              variants={item}
              className="rounded-card border border-border bg-surface overflow-hidden hover:border-accent/30 transition-colors cursor-pointer"
              onClick={() => setSelectedAccount(account)}
            >
              {/* Header */}
              <div className="p-4 border-b border-border">
                <div className="flex items-center justify-between">
                  <div className="flex items-center gap-3">
                    <div className={`w-10 h-10 rounded-lg flex items-center justify-center text-white font-bold ${account.name === 'Pari' ? 'bg-indigo-500' : account.name === 'Fonbet' ? 'bg-emerald-500' : 'bg-amber-500'}`}>
                      {account.name[0]}
                    </div>
                    <div>
                      <div className="font-semibold text-text-primary">{account.name}</div>
                      <div className="flex items-center gap-1.5">
                        <div className={`w-1.5 h-1.5 rounded-full ${statusConfig[account.connectionStatus as keyof typeof statusConfig]?.color || 'bg-gray-500'}`} />
                        <span className="text-xs text-text-secondary">{statusConfig[account.connectionStatus as keyof typeof statusConfig]?.label || account.connectionStatus}</span>
                      </div>
                    </div>
                  </div>
                  <div className={`text-xs px-2 py-1 rounded border ${riskConfig[account.riskLevel as keyof typeof riskConfig]?.color || ''}`}>
                    {riskConfig[account.riskLevel as keyof typeof riskConfig]?.label || account.riskLevel}
                  </div>
                </div>
              </div>

              {/* Body */}
              <div className="p-4 space-y-4">
                {/* Balance */}
                <div>
                  <div className="text-sm text-text-secondary mb-1">Баланс</div>
                  <div className="text-xl font-bold text-text-primary">{formatMoney(account.balance)}</div>
                  <div className="text-xs text-text-secondary">Доступно: {formatMoney(account.available)}</div>
                </div>

                {/* Daily limit progress */}
                <div>
                  <div className="flex justify-between text-xs mb-1.5">
                    <span className="text-text-secondary">Дневной лимит</span>
                    <span className="text-text-primary">{formatMoney(account.usedToday)} / {formatMoney(account.dailyLimit)}</span>
                  </div>
                  <div className="h-1.5 bg-background rounded-full overflow-hidden">
                    <div 
                      className={`h-full rounded-full transition-all ${(account.usedToday/account.dailyLimit) > 0.8 ? 'bg-red-500' : (account.usedToday/account.dailyLimit) > 0.5 ? 'bg-amber-500' : 'bg-emerald-500'}`}
                      style={{ width: `${Math.min((account.usedToday/account.dailyLimit)*100, 100)}%` }}
                    />
                  </div>
                </div>

                {/* Stats */}
                <div className="grid grid-cols-2 gap-3 text-sm">
                  <div>
                    <span className="text-text-secondary">Ставок:</span>
                    <span className="ml-2 text-text-primary">{account.totalBets}</span>
                  </div>
                  <div>
                    <span className="text-text-secondary">Профит:</span>
                    <span className={`ml-2 ${account.totalProfit >= 0 ? 'text-emerald-400' : 'text-red-400'}`}>
                      {formatMoney(account.totalProfit)}
                    </span>
                  </div>
                  <div>
                    <span className="text-text-secondary">Макс. ставка:</span>
                    <span className="ml-2 text-text-primary">{formatMoney(account.maxBet)}</span>
                  </div>
                  <div>
                    <span className="text-text-secondary">Последняя:</span>
                    <span className="ml-2 text-text-primary">{formatRelativeTime(account.lastBet)}</span>
                  </div>
                </div>

                {/* Bonuses */}
                {account.bonuses.length > 0 && (
                  <div className="flex flex-wrap gap-2">
                    {account.bonuses.map(bonus => (
                      <span key={bonus.id} className="text-xs px-2 py-1 rounded-full bg-purple-500/20 text-purple-400 border border-purple-500/30">
                        {bonus.name}
                      </span>
                    ))}
                  </div>
                )}

                {/* Risk warnings */}
                {account.riskFactors.length > 0 && (
                  <div className="p-2.5 bg-red-500/10 border border-red-500/20 rounded-lg">
                    <div className="text-xs text-red-400 font-semibold flex items-center gap-1">
                      <AlertTriangle size={12} /> Риски:
                    </div>
                    {account.riskFactors.slice(0, 2).map((factor, i) => (
                      <div key={i} className="text-xs text-red-300 mt-1">• {factor.description}</div>
                    ))}
                  </div>
                )}
              </div>
            </motion.div>
          ))}
        </div>
      </motion.div>

      {/* AI Recommendations */}
      <motion.div variants={item} className="rounded-card border border-border bg-surface p-5">
        <div className="flex items-center gap-2 mb-4">
          <Bot size={18} className="text-accent" />
          <h3 className="text-base font-semibold text-text-primary">Рекомендации ИИ</h3>
        </div>
        <div className="space-y-3">
          <div className="flex items-start gap-3 p-3 rounded-lg bg-amber-500/10 border border-amber-500/20">
            <AlertTriangle size={16} className="text-amber-400 shrink-0 mt-0.5" />
            <div>
              <div className="text-sm text-amber-300 font-medium">Снизить активность на Leon</div>
              <div className="text-xs text-text-secondary mt-1">Высокий риск блокировки. Рекомендуется уменьшить частоту ставок.</div>
            </div>
            <button className="text-xs text-accent hover:text-accent-hover shrink-0">Подробнее</button>
          </div>
          <div className="flex items-start gap-3 p-3 rounded-lg bg-blue-500/10 border border-blue-500/20">
            <RefreshCw size={16} className="text-blue-400 shrink-0 mt-0.5" />
            <div>
              <div className="text-sm text-blue-300 font-medium">Обновить сессию Fonbet</div>
              <div className="text-xs text-text-secondary mt-1">Сессия истекает через 2 часа. Рекомендуется обновить заранее.</div>
            </div>
            <button className="text-xs text-accent hover:text-accent-hover shrink-0">Обновить</button>
          </div>
        </div>
      </motion.div>

      {/* Account Detail Modal */}
      <AnimatePresence>
        {selectedAccount && (
          <motion.div 
            initial={{ opacity: 0 }}
            animate={{ opacity: 1 }}
            exit={{ opacity: 0 }}
            className="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/70"
            onClick={() => setSelectedAccount(null)}
          >
            <motion.div 
              initial={{ scale: 0.95, opacity: 0 }}
              animate={{ scale: 1, opacity: 1 }}
              exit={{ scale: 0.95, opacity: 0 }}
              className="w-full max-w-lg max-h-[90vh] overflow-auto rounded-2xl bg-surface border border-border"
              onClick={e => e.stopPropagation()}
            >
              {/* Modal Header */}
              <div className="p-5 border-b border-border">
                <div className="flex items-center justify-between">
                  <div className="flex items-center gap-3">
                    <div className={`w-12 h-12 rounded-xl flex items-center justify-center text-white font-bold text-lg ${selectedAccount.name === 'Pari' ? 'bg-indigo-500' : selectedAccount.name === 'Fonbet' ? 'bg-emerald-500' : 'bg-amber-500'}`}>
                      {selectedAccount.name[0]}
                    </div>
                    <div>
                      <h2 className="text-lg font-semibold text-text-primary">{selectedAccount.name}</h2>
                      <div className="flex items-center gap-1.5">
                        <div className={`w-2 h-2 rounded-full ${statusConfig[selectedAccount.connectionStatus as keyof typeof statusConfig]?.color || 'bg-gray-500'}`} />
                        <span className="text-xs text-text-secondary">{statusConfig[selectedAccount.connectionStatus as keyof typeof statusConfig]?.label || selectedAccount.connectionStatus}</span>
                      </div>
                    </div>
                  </div>
                  <button onClick={() => setSelectedAccount(null)} className="p-2 rounded-lg hover:bg-white/5 text-text-muted">
                    <X size={18} />
                  </button>
                </div>
              </div>

              {/* Modal Body */}
              <div className="p-5 space-y-5">
                {/* Balance Grid */}
                <div className="grid grid-cols-2 gap-3">
                  <div className="p-3 rounded-lg bg-background">
                    <div className="text-xs text-text-secondary mb-1">Баланс</div>
                    <div className="text-lg font-bold text-text-primary">{formatMoney(selectedAccount.balance)}</div>
                  </div>
                  <div className="p-3 rounded-lg bg-background">
                    <div className="text-xs text-text-secondary mb-1">Доступно</div>
                    <div className="text-lg font-bold text-emerald-400">{formatMoney(selectedAccount.available)}</div>
                  </div>
                  <div className="p-3 rounded-lg bg-background">
                    <div className="text-xs text-text-secondary mb-1">В ставках</div>
                    <div className="text-lg font-bold text-blue-400">{formatMoney(selectedAccount.locked)}</div>
                  </div>
                  <div className="p-3 rounded-lg bg-background">
                    <div className="text-xs text-text-secondary mb-1">Дневной лимит</div>
                    <div className="text-lg font-bold text-text-primary">{formatMoney(selectedAccount.dailyLimit)}</div>
                  </div>
                </div>

                {/* Limits */}
                <div>
                  <h4 className="text-sm font-semibold text-text-primary mb-3">Лимиты</h4>
                  <div className="space-y-3">
                    <div>
                      <div className="flex justify-between text-xs mb-1">
                        <span className="text-text-secondary">Дневной лимит</span>
                        <span className="text-text-primary">{formatMoney(selectedAccount.usedToday)} / {formatMoney(selectedAccount.dailyLimit)}</span>
                      </div>
                      <div className="h-2 bg-background rounded-full">
                        <div className={`h-full rounded-full ${(selectedAccount.usedToday/selectedAccount.dailyLimit) > 0.8 ? 'bg-red-500' : 'bg-emerald-500'}`} 
                          style={{ width: `${Math.min((selectedAccount.usedToday/selectedAccount.dailyLimit)*100, 100)}%` }} />
                      </div>
                    </div>
                  </div>
                </div>

                {/* Stats */}
                <div>
                  <h4 className="text-sm font-semibold text-text-primary mb-3">Статистика</h4>
                  <div className="grid grid-cols-3 gap-3">
                    <div className="p-3 rounded-lg bg-background text-center">
                      <div className="text-xl font-bold text-text-primary">{selectedAccount.totalBets}</div>
                      <div className="text-xs text-text-secondary">Ставок</div>
                    </div>
                    <div className="p-3 rounded-lg bg-background text-center">
                      <div className={`text-xl font-bold ${selectedAccount.totalProfit >= 0 ? 'text-emerald-400' : 'text-red-400'}`}>
                        {formatMoney(selectedAccount.totalProfit)}
                      </div>
                      <div className="text-xs text-text-secondary">Профит</div>
                    </div>
                    <div className="p-3 rounded-lg bg-background text-center">
                      <div className="text-xl font-bold text-text-primary">{Math.round((selectedAccount.wonBets/selectedAccount.totalBets)*100)}%</div>
                      <div className="text-xs text-text-secondary">Win Rate</div>
                    </div>
                  </div>
                </div>

                {/* Bonuses */}
                {selectedAccount.bonuses.length > 0 && (
                  <div>
                    <h4 className="text-sm font-semibold text-text-primary mb-3">Бонусы</h4>
                    <div className="space-y-2">
                      {selectedAccount.bonuses.map((bonus: any) => (
                        <div key={bonus.id} className="flex items-center justify-between p-3 rounded-lg bg-background">
                          <div>
                            <div className="text-sm text-text-primary">{bonus.name}</div>
                            <div className="text-xs text-text-secondary">Вейджер x{bonus.wagering}</div>
                          </div>
                          <div className="text-right">
                            <div className="text-sm font-medium text-purple-400">{formatMoney(bonus.amount)}</div>
                            <div className="text-xs text-text-secondary">до {formatRelativeTime(bonus.expiresAt)}</div>
                          </div>
                        </div>
                      ))}
                    </div>
                  </div>
                )}
              </div>

              {/* Modal Footer */}
              <div className="p-5 border-t border-border flex gap-3">
                <button className="btn btn-secondary text-sm flex-1">Отключить</button>
                <button className="btn btn-primary text-sm flex-1">Обновить баланс</button>
              </div>
            </motion.div>
          </motion.div>
        )}
      </AnimatePresence>
    </motion.div>
  )
}
